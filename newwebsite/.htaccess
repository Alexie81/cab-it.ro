Options -Indexes
DirectoryIndex index.html index.php
AddType application/manifest+json .webmanifest

# Pagina personalizată 404
ErrorDocument 404 /404/index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Un singur domeniu canonic: HTTPS fără www.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^cab-it\.ro$ [NC]
    RewriteRule ^(.*)$ https://cab-it.ro/$1 [R=301,L,NE]

    # Elimină index.html din URL-urile publice.
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
    RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

    # Păstrează semnalele acumulate de articolele mutate în iulie 2026.
    RewriteRule ^blog/cat-costa-website-profesional-2026/?$ /blog/cat-costa-un-site-web-profesional/ [R=301,L,NE]
    RewriteRule ^blog/prioritati-seo-pentru-imm/?$ /blog/optimizare-seo-pentru-site/ [R=301,L,NE]
    RewriteRule ^blog/promovare-online-bucuresti-ghid-firme/?$ /blog/promovare-online-romania-canale-potrivite/ [R=301,L,NE]
    RewriteRule ^blog/indicatori-campanie-promovare-online/?$ /blog/promovare-online-romania-canale-potrivite/ [R=301,L,NE]
    RewriteRule ^blog/core-web-vitals-lcp-cls-inp/?$ /glosar-seo/#core-web-vitals [R=301,L,NE]

    # Nu modifica accesul la panoul de administrare.
    RewriteRule ^adminpanelcabitro(?:/.*)?$ - [L]

    # Nu rescrie fișierele și directoarele existente.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Pentru paginile statice fără extensia .html.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # Dacă există un director cu index.html, îl încarcă.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    <FilesMatch "\.(?:css|js|webp|png|jpe?g|svg|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <Files "service-worker.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </Files>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Permite execuția endpointurilor PHP publice.
<FilesMatch "\.php$">
    Require all granted
</FilesMatch>

# Protejează fișierele de configurare și dezvoltare.
<FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json|README.*|\.git.*)$">
    Require all denied
</FilesMatch>
